{
  "buildCommand": "npm run build && npm run check:ssr",
  "outputDirectory": "dist/client",
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/server/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/digest-daily",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/digest-weekly",
      "schedule": "0 6 * * 1"
    }
  ]
}
