{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StitchBook",
  "version": "0.1.0",
  "identifier": "com.abdulwahab.stitchbook",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "title": "StitchBook",
        "url": "https://abdulwahab-portfolio-tau.vercel.app/stitchbook",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
