# Optional: Gemini API key, used server-side to translate CMS content for French and Arabic visitors. It's also
# the AI assistant's free fallback model whenever ANTHROPIC_API_KEY isn't set (see below) -- Gemini has a
# permanent free tier, no card required, so the assistant can run at zero cost until there's budget for Anthropic.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Supabase Credentials
VITE_SUPABASE_URL="YOUR_SUPABASE_URL"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# SITE_URL: optional public URL of the site (e.g. a custom domain). Used for password-reset links,
# canonical/og:url tags and the sitemap. On Vercel it defaults to the project's production domain.
# SITE_URL="https://example.com"

# AI assistant (server only). Without CHAT_DATABASE_URL + CHAT_VISITOR_SALT + (ANTHROPIC_API_KEY or
# GEMINI_API_KEY above), /api/chat answers 503 and the widget points visitors to /contact. If ANTHROPIC_API_KEY
# is set, it's used; otherwise the assistant falls back to GEMINI_API_KEY automatically -- no other config needed
# to switch between them.
# ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY"
# Restricted read-only login, via the Supabase transaction pooler (Dashboard > Connect > Transaction pooler)
# CHAT_DATABASE_URL="postgresql://chatbot_reader.YOUR_PROJECT_REF:PASSWORD@YOUR_POOLER_HOST:6543/postgres"
# Random string of 32+ characters, used to hash visitor IPs for rate limiting
# CHAT_VISITOR_SALT="RANDOM_STRING"
# Optional overrides -- set to a Gemini model id (e.g. "gemini-2.5-flash") or an Anthropic one depending on
# whichever provider is actually active
# CHAT_MODEL="claude-haiku-4-5-20251001"
# CHAT_EFFORT="low"

# AtelierFit (tailor order + AI measurement app, under /atelierfit). PAYSTACK_SECRET_KEY is already set in Vercel.
# PAYSTACK_PUBLIC_KEY is still missing -- find it next to the secret key on the Paystack dashboard (Settings ->
# API Keys & Webhooks) and add it too; without it, orders are still recorded but the in-app payment button stays
# off and the tailor has to follow up manually to collect the deposit.
# PAYSTACK_SECRET_KEY="sk_test_..."
# PAYSTACK_PUBLIC_KEY="pk_test_..."
