# Optional: Gemini API key, used server-side to translate CMS content for French and Arabic visitors.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Supabase Credentials
VITE_SUPABASE_URL="YOUR_SUPABASE_URL"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# SITE_URL: optional public URL of the site (e.g. a custom domain). Used for password-reset links,
# canonical/og:url tags and the sitemap. On Vercel it defaults to the project's production domain.
# SITE_URL="https://example.com"

# AI assistant (server only). Without these, /api/chat answers 503 and the widget points visitors to /contact.
# ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY"
# Restricted read-only login, via the Supabase transaction pooler (Dashboard > Connect > Transaction pooler)
# CHAT_DATABASE_URL="postgresql://chatbot_reader.YOUR_PROJECT_REF:PASSWORD@YOUR_POOLER_HOST:6543/postgres"
# Random string of 32+ characters, used to hash visitor IPs for rate limiting
# CHAT_VISITOR_SALT="RANDOM_STRING"
# Optional overrides
# CHAT_MODEL="claude-opus-5-5"
# CHAT_EFFORT="low"
